[Unit]
Description=Chick Link encrypted relay
After=network.target

[Service]
StartLimitInterval=60
StartLimitBurst=5
Type=simple
User=chicklink
Group=chicklink
WorkingDirectory=/opt/chicklink
Environment=BIND_ADDR=127.0.0.1:18080
Environment=LAN_DISCOVERY=false
Environment=RELAY_REQUIRE_ENCRYPTION=true
Environment=RELAY_REQUIRE_PROVISIONED_TOKENS=true
Environment=RELAY_RSA_PRIVATE_KEY_PATH=/opt/chicklink/secrets/relay-private.pem
Environment=RELAY_ACCESS_TOKENS_PATH=/opt/chicklink/secrets/access-tokens.json
Environment=RELAY_STATE_PATH=/opt/chicklink/state/relationships.json
ExecStart=/opt/chicklink/bin/relay-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryAccounting=true
MemoryLimit=128M
CPUAccounting=true
CPUQuota=25%
Nice=10
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
