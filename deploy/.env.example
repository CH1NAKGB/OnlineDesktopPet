# Public hostname used by desktop clients.
PUBLIC_HOST=relay.example.com

# Public host port for docker-compose.encrypted-direct.yml. It does not bind
# host ports 80, 443, or 8080; the container's private port remains 8080.
RELAY_PUBLIC_PORT=18080
# The relay.sh script reads the version from Cargo.toml and overrides this
# value. Keep it in sync when invoking Docker Compose directly.
CHICKLINK_VERSION=0.3.4
RELAY_RSA_PRIVATE_KEY_FILE=./secrets/relay-private.pem
RELAY_ACCESS_TOKENS_FILE=./secrets/access-tokens.json

# The relay itself only accepts this bind address. Caddy provides public TLS.
BIND_ADDR=0.0.0.0:8080

# Set to true only for a relay running inside a trusted LAN. mDNS discovery is
# intentionally disabled for the public cloud deployment by default.
LAN_DISCOVERY=false

# Optional LAN announcement overrides for reverse proxies or `wss://` endpoints.
LAN_DISCOVERY_SCHEME=ws
LAN_DISCOVERY_HOST=
LAN_DISCOVERY_PORT=
LAN_DISCOVERY_PATH=/ws

# Optional: enables application-layer encryption over ordinary ws://.
# This PEM private key is never copied to clients. Generate its matching public
# key once, then configure the client with CHICK_SERVER_RSA_PUBLIC_KEY_PATH.
RELAY_RSA_PRIVATE_KEY_PATH=

# Optional JSON map from random opaque access tokens to internal owner IDs.
# When configured, dev:<name> identities are rejected.
RELAY_ACCESS_TOKENS_PATH=
RELAY_REQUIRE_ENCRYPTION=false
RELAY_REQUIRE_PROVISIONED_TOKENS=false
