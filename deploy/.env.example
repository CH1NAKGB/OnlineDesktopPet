# Public hostname used by desktop clients.
PUBLIC_HOST=relay.example.com

# The relay itself only accepts this bind address. Caddy provides public TLS.
BIND_ADDR=0.0.0.0:8080

# Set to true only for a relay running inside a trusted LAN. mDNS discovery is
# intentionally disabled for the public cloud deployment by default.
LAN_DISCOVERY=false

# Optional LAN announcement overrides for reverse proxies or `wss://` endpoints.
LAN_DISCOVERY_SCHEME=ws
LAN_DISCOVERY_HOST=
LAN_DISCOVERY_PORT=
LAN_DISCOVERY_PATH=/ws

# Optional: enables application-layer encryption over ordinary ws://.
# This PEM private key is never copied to clients. Generate its matching public
# key once, then configure the client with CHICK_SERVER_RSA_PUBLIC_KEY_PATH.
RELAY_RSA_PRIVATE_KEY_PATH=
